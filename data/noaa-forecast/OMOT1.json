{"gauge":{"lid":"OMOT1","usgsId":"03431091","reachId":"18408666","name":"Cumberland River at Omohundro","description":"","rfc":{"abbreviation":"OHRFC","name":"Ohio River Forecast Center"},"wfo":{"abbreviation":"OHX","name":"Old Hickory"},"state":{"abbreviation":"TN","name":"Tennessee"},"county":"Davidson","timeZone":"CST6CDT","latitude":36.165277777778,"longitude":-86.721388888889,"pedts":{"observed":"HGIRG","forecast":"HGIFF"},"status":{"observed":{"primary":19.55,"primaryUnit":"ft","secondary":-999,"secondaryUnit":"kcfs","floodCategory":"no_flooding","validTime":"2026-11-14T16:00:00Z"},"forecast":{"primary":-999,"primaryUnit":"","secondary":-999,"secondaryUnit":"","floodCategory":"fcst_not_current","validTime":"0001-01-01T00:00:00Z"}},"flood":{"stageUnits":"ft","flowUnits":"cfs","categories":{"major":{"stage":50,"flow":-9999},"moderate":{"stage":45,"flow":-9999},"minor":{"stage":41,"flow":-9999},"action":{"stage":35,"flow":-9999}},"lro":null,"crests":{"historic":[{"occurredTime":"2019-02-24T07:00:00Z","stage":44.69,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2013-04-29T00:00:00Z","stage":36.37,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2011-03-01T00:00:00Z","stage":33.62,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2012-03-09T00:00:00Z","stage":32.63,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2014-02-05T00:00:00Z","stage":32,"flow":0,"preliminary":"O","olddatum":false}],"recent":[{"occurredTime":"2019-02-24T07:00:00Z","stage":44.69,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2014-02-05T00:00:00Z","stage":32,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2013-04-29T00:00:00Z","stage":36.37,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2012-03-09T00:00:00Z","stage":32.63,"flow":0,"preliminary":"O","olddatum":false},{"occurredTime":"2011-03-01T00:00:00Z","stage":33.62,"flow":0,"preliminary":"O","olddatum":false}]},"lowWaters":{"historic":[]},"impacts":[{"stage":56,"statement":"Substantial flooding is occurring in the Dugger Heights, Rosebank, Barclay Dr, Boscobel Heights, and Shelby Hills areas, as well as Cornelia Fort, Shelby Bottoms, and the Vinny Links Golf Course. Backwater effects are flooding areas along Mill Creek up to I-40, and Browns Creek up to Murfreesboro Pike. Industrial areas on Davidson St, Driftwood St, Nestor St, Stanley St, Visco Dr, Fesslers Ln, Omohundro Dr, and River Hills Dr are significantly flooded."},{"stage":54,"statement":"Extensive flooding continues on Barclay Dr, Brittany Dr, Beth Dr, Crutcher St, Cave Rd, Davidson St, Dixon Dr, Driftwood St, Electric Ave, Fulton St, Nestor St, Rolling Hills Dr, Shadow Ln, Spence Ln, Stanley St, South Fourteenth St, Village Ct, and Visco Dr. Cornelia Fort, Shelby Bottoms, and the Vinny Links Golf Course are flooded. Backwater effects are flooding areas along Mill Creek up to I-40, and Browns Creek up to Murfreesboro Pike."},{"stage":52,"statement":"Water approaches property on Crutcher St between South Fifth St and South Twelvth St, near Electric Ave and Village Ct, along South Fourteenth St, and near Cave Rd and Spence Ln. Flooding continues on Barclay Dr, Brittany Dr, Beth Dr, Davidson St, Driftwood St, Nestor St, Shadow Ln, Stanley St, Visco Dr, Rolling Hills Dr, and at Cornelia Fort Airpark, Shelby Bottoms Park, and the Vinny Links Golf Course. Mill Creek is flooding up to I-40 and Browns Creek is flooding up to Murfreesboro Pike."},{"stage":50,"statement":"Extensive flooding of homes and roads is occurring along the river. Impacted locations include Barclay Dr, Brittany Dr, Beth Dr, Davidson St, Driftwood St, Nestor St, Shadow Ln, Stanley St, Visco Dr, and Rolling Hills Dr. Cornelia Fort Airpark, Shelby Bottoms Park and the Vinny Links Golf Course are mostly flooded. Backwater effects are flooding areas along Mill Creek up to I-40, and Browns Creek up to Murfressboro Pike."},{"stage":49,"statement":"Many properties and roads continue to be impacted including Davidson St, Driftwood St, Nestor St, Stanley St, Visco Dr, and Rolling Hills Dr. The Cornelia Fort Airpark is mostly flooded and water approaches property on Shadow Ln. Shelby Bottoms Park and the Vinny Links Golf Course are also flooded and water approaches property on Barclay Dr, Brittany Dr, and Beth Dr. Mill Creek is flooding adjacent property up to I-40, and Browns Creek is flooding property up to Murfreesboro Pike."},{"stage":47,"statement":"Shelby Bottoms Park is mostly inundated, and property and structures continue to be impacted on Davidson St, Driftwood St, Nestor St, Stanley St, Visco Dr, Rolling Hills Dr, the Cornelia Fort Airpark, the Vinny Links Golf Course, and Mill Creek near Lebanon Pike. Backwater effects begin on Browns Creek, flooding property along the creek to near Murfreesboro Pike."},{"stage":45,"statement":"Flooding continues along the river from the Cumberland River Greenway Bridge in Shelby Bottoms Park to the I-24 bridge near downtown. Affected areas include properties and structures on Davidson St, Nestor St, Visco dr, and Rolling Hills Dr. Backwater effects are also causing flooding on Mill Creek near the East Haven townhomes. Water also begins to flood Cornelia Fort Airpark, the Vinny Links Golf Course, and areas near Driftwood St and Stanley St."},{"stage":43,"statement":"Properties on Davidson St, Nestor St, and Visco Dr continue to be flooded with water approaching structures in some areas. Water begins to approach property on River Hills Dr."},{"stage":41,"statement":"Flooding along the river begins from the Cumberland River Greenway Bridge in Shelby Bottoms Park to the I-24 bridge near downtown. This includes the ballfields and other areas in Shelby Bottoms Park, and properties adjacent to the river on Davidson St, Nestor St, and Visco Dr. Backwater effects also begin to cause flooding on Mill Creek up to near Lebanon Pike."},{"stage":40,"statement":"Portions of Shelby Bottoms Park are inundated, mainly near the ball fields and along the greenway trails near the river. Water begins to approach properties adjacent to the river on Davidson St, Nestor St, and Visco Dr."},{"stage":38,"statement":"Shelby Bottoms Park begins to be inundated near the ball fields, and portions of the greenway trail may be impassable. Water begins to back up Mill Creek and is inundating low lying areas near Lebanon Pike."},{"stage":35,"statement":"Low lying areas along both sides of the river are inundated, including portions of Shelby Bottoms Park."}]},"images":{"probability":{"weekint":{"stage":"","flow":"","volume":""},"entperiod":{"stage":"","flow":"","volume":""},"shortrange":""},"hydrograph":{"default":"https://water.noaa.gov/resources/hydrographs/omot1_hg.png","floodcat":"https://water.noaa.gov/resources/hydrographs/omot1_record.png"},"photos":[]},"dataAttribution":[{"abbrev":"US Geological Survey","text":"USGS--Water Resources of the United States","title":"US Geological Survey","url":"https://waterdata.usgs.gov/nwis"},{"abbrev":"USGS","text":"03431091","title":"Observations courtesy of U.S. Geological Survey","url":"https://waterdata.usgs.gov/nwis/inventory/?site_no=03431091"}],"impactsLowWaters":[],"normalThreshold":{"value":0,"units":"ft"},"hydronotes":[],"datums":{"vertical":{"value":[{"label":"North American Vertical Datum of 1988","abbrev":"NAVD88","description":"A fixed reference for elevations determined by geodetic leveling. The datum was derived from a general adjustment of the first-order terrestrial leveling nets of the United States, Canada, and Mexico. In the adjustment, only the height of the primary tidal bench mark, referenced to the International Great Lakes Datum of 1985 (IGLD 85) local mean sea level height value, at Father Point, Rimouski, Quebec, Canada was held fixed, thus providing minimum constraint. NAVD 88 and IGLD 85 are identical. However, NAVD 88 bench mark values are given in Helmert orthometric height units while IGLD 85 values are in dynamic heights. See International Great Lakes Datum of 1985, National Geodetic Vertical Datum of 1929, and geopotential difference. NAVD 88 should not be used as Mean Sea Level.","value":365.5}]},"horizontal":{"value":[]},"notes":{"value":[]}},"inundation":{"enabled":false,"url":"","zeroDatum":null,"downloads":null,"siteSpecificInfo":"","dataAttribution":[]},"upstreamLid":"PNBT1","downstreamLid":"NAST1","inService":{"enabled":true,"message":""},"lowThreshold":null,"forecastReliability":"Forecasts are not available. Only observed stages are available for this point.","TruncateObs":"-1","TruncateFcst":"5","ObservedFloodCategory":"no_flooding","ForecastFloodCategory":"fcst_not_current"},"stageflow":{"observed":{"pedts":"HGIRG","issuedTime":"2026-11-14T16:00:00Z","wfo":"OHX","timeZone":"CST6CDT","primaryName":"Stage","primaryUnits":"ft","secondaryName":"Flow","secondaryUnits":"kcfs","data":[{"validTime":"2026-11-13T15:15:00Z","generatedTime":"2026-11-13T16:24:12Z","primary":19.99,"secondary":-999},{"validTime":"2026-11-13T15:30:00Z","generatedTime":"2026-11-13T16:24:12Z","primary":19.96,"secondary":-999},{"validTime":"2026-11-13T15:45:00Z","generatedTime":"2026-11-13T16:24:12Z","primary":19.92,"secondary":-999},{"validTime":"2026-11-13T16:00:00Z","generatedTime":"2026-11-13T16:24:12Z","primary":19.91,"secondary":-999},{"validTime":"2026-11-13T16:15:00Z","generatedTime":"2026-11-13T17:24:11Z","primary":19.9,"secondary":-999},{"validTime":"2026-11-13T16:30:00Z","generatedTime":"2026-11-13T17:24:11Z","primary":19.87,"secondary":-999},{"validTime":"2026-11-13T16:45:00Z","generatedTime":"2026-11-13T17:24:11Z","primary":19.86,"secondary":-999},{"validTime":"2026-11-13T17:00:00Z","generatedTime":"2026-11-13T17:24:11Z","primary":19.88,"secondary":-999},{"validTime":"2026-11-13T17:15:00Z","generatedTime":"2026-11-13T18:24:13Z","primary":19.93,"secondary":-999},{"validTime":"2026-11-13T17:30:00Z","generatedTime":"2026-11-13T18:24:13Z","primary":19.89,"secondary":-999},{"validTime":"2026-11-13T17:45